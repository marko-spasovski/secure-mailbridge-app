# Mailbridge: every environment variable the app reads, for the AWS lab container.
# No real values here. In the lab, variables marked SECRET come from AWS SSM and are injected by the host;
# never put them in the image, a build arg, the repo or a log. Empty = unset (the default applies).
# Full reference: docs/deployment.md.

# --- Runtime --------------------------------------------------------------------------------------------------
# Required. "production" turns on the production checks, the __Host- Secure session cookie and HSTS.
NODE_ENV=production
# Listen port (plain HTTP; TLS ends at Nginx). Default 3000.
PORT=3000
# fatal | error | warn | info | debug | trace | silent. Default info. JSON lines on stdout.
LOG_LEVEL=info

# --- Public address and proxy ---------------------------------------------------------------------------------
# Required in production. The origin users see, https only, no path, no trailing slash. Builds the OAuth
# redirect URIs (<PUBLIC_ORIGIN>/accounts/callback/gmail and /accounts/callback/outlook) and reset links.
PUBLIC_ORIGIN=https://mail.<domain>
# Required >= 1 in production: proxy hops whose X-Forwarded-For / X-Forwarded-Proto are trusted. Lab: 1 (Nginx).
TRUST_PROXY=1

# --- Secrets for sessions and stored tokens -------------------------------------------------------------------
# Format of both: raw text, used exactly as given (NOT decoded from hex or base64), surrounding whitespace trimmed.
# Production requires at least 32 characters, must not start with REPLACE_, and the two must differ.
# Recommended: 64 hex characters (256 random bits), e.g. `openssl rand -hex 32`, generated separately for each.
# Base64 output (`openssl rand -base64 32`, 44 characters) is also accepted. Use ASCII only, no newlines.
#
# SECRET. Signs the session cookie and keys the rate-limit counters. Changing it signs everyone out.
SESSION_SECRET=
# SECRET. Encrypts mailbox OAuth tokens in the database (AES-256-GCM, key derived with HKDF-SHA256).
# Changing it makes every stored mailbox unreadable (reconnect), unless rotated: docs/runbooks/key-rotation.md.
TOKEN_ENCRYPTION_KEY=
# SECRET, only while rotating TOKEN_ENCRYPTION_KEY: the old key. Leave empty otherwise.
TOKEN_ENCRYPTION_KEY_PREVIOUS=

# --- PostgreSQL -----------------------------------------------------------------------------------------------
# All required except the TLS settings.
POSTGRES_HOST=10.0.4.10
POSTGRES_PORT=5432
POSTGRES_DB=mailbridge
POSTGRES_USER=mailbridge
# SECRET.
POSTGRES_PASSWORD=
# TLS to PostgreSQL: true | false (default false). When true the server certificate is always fully verified:
# the chain must lead to a trusted CA and the certificate must name POSTGRES_HOST (an IP SAN for 10.0.4.10).
POSTGRES_SSL=false
# Optional PEM of the CA that signed the server certificate (private CA). Real newlines or literal \n are both
# accepted, so it fits in one variable. Empty: the system's public CAs. Only allowed with POSTGRES_SSL=true.
POSTGRES_SSL_CA=

# --- Accounts -------------------------------------------------------------------------------------------------
# Anyone reaching the app may create an account: true | false. Default true.
ALLOW_REGISTRATION=true

# --- Microsoft (Outlook via Graph) ----------------------------------------------------------------------------
# Set both or neither; without them the Outlook connect button is disabled.
# Redirect URI to register in Entra: https://mail.<domain>/accounts/callback/outlook
MICROSOFT_CLIENT_ID=
# SECRET.
MICROSOFT_CLIENT_SECRET=
# Tenant for sign-in: common (default), organizations, consumers or a tenant ID.
MICROSOFT_TENANT=common

# --- Google (Gmail API) ---------------------------------------------------------------------------------------
# Set both or neither; without them the Gmail connect button is disabled.
# Redirect URI to register in Google Cloud: https://mail.<domain>/accounts/callback/gmail
GOOGLE_CLIENT_ID=
# SECRET.
GOOGLE_CLIENT_SECRET=
# Optional invite list: app sign-in emails allowed to connect Gmail, comma-separated. Empty = everyone.
GMAIL_ALLOWED_EMAILS=

# --- Password-reset mail (leave unset in the lab: egress allows only 443) -------------------------------------
# Without SMTP_HOST, production sends no reset mail and logs a warning; reset passwords with
# `node dist/scripts/reset-password.js` instead (docs/deployment.md).
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
# SECRET.
SMTP_PASSWORD=
SMTP_FROM=
